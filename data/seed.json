{
  "system": {
    "name": "Meadowlark Ground Control Station (fictional)",
    "description": "Synthetic requirements and test data for a fictional small-UAS ground control station. All data invented for demonstration; no real programme, customer, or classified information.",
    "version": "1.0"
  },
  "requirements": [
    {
      "req_id": "REQ-COM-001",
      "title": "Establish datalink on power-on",
      "text": "The ground station shall establish a datalink with the aircraft within 30 seconds of power-on under nominal RF conditions.",
      "subsystem": "Datalink & Communications",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-002",
      "title": "Telemetry downlink rate",
      "text": "The ground station shall receive and display telemetry updates at a minimum rate of 1 Hz during normal operations.",
      "subsystem": "Datalink & Communications",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-003",
      "title": "Telemetry buffering during link loss",
      "text": "The ground station shall buffer incoming telemetry for at least 10 minutes during a datalink outage and backfill the display on reconnection.",
      "subsystem": "Datalink & Communications",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-004",
      "title": "Command uplink encryption",
      "text": "All command uplinks shall be encrypted using AES-256 with per-session keys.",
      "subsystem": "Datalink & Communications",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-005",
      "title": "Reject unauthenticated commands",
      "text": "The ground station shall reject any command message that fails authentication tag verification and shall log the rejection.",
      "subsystem": "Datalink & Communications",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-006",
      "title": "Dual-radio failover",
      "text": "On loss of the primary radio link, the ground station shall fail over to the secondary radio without operator intervention.",
      "subsystem": "Datalink & Communications",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-COM-007",
      "title": "Link quality display",
      "text": "The operator interface shall display current link quality, signal strength, and round-trip latency, updated at least once per second.",
      "subsystem": "Datalink & Communications",
      "priority": "Medium",
      "verification_method": "Demonstration"
    },
    {
      "req_id": "REQ-NAV-001",
      "title": "Geofence boundary enforcement",
      "text": "The system shall enforce operator-configured geofence boundaries and alert the operator before a predicted boundary crossing.",
      "subsystem": "Navigation & Geofencing",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-002",
      "title": "Position accuracy",
      "text": "The ground station shall display aircraft position with an accuracy of 3 m CEP or better when GPS conditions are nominal.",
      "subsystem": "Navigation & Geofencing",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-003",
      "title": "Return-to-home on boundary warning timeout",
      "text": "If the operator does not acknowledge a boundary warning within 15 seconds, the system shall command a return-to-home.",
      "subsystem": "Navigation & Geofencing",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-004",
      "title": "Route upload and validation",
      "text": "The ground station shall validate an uploaded route for altitude, distance, and boundary violations before allowing it to be sent to the aircraft.",
      "subsystem": "Navigation & Geofencing",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-005",
      "title": "GPS degradation alert",
      "text": "The ground station shall detect degradation of the GPS solution and alert the operator within 5 seconds.",
      "subsystem": "Navigation & Geofencing",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-006",
      "title": "Navigation solution logging",
      "text": "The ground station shall log the navigation solution, including position and velocity, at a minimum rate of 5 Hz.",
      "subsystem": "Navigation & Geofencing",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-NAV-007",
      "title": "Compass calibration workflow",
      "text": "The ground station shall provide a guided magnetic compass calibration workflow with pass/fail feedback.",
      "subsystem": "Navigation & Geofencing",
      "priority": "Low",
      "verification_method": "Demonstration"
    },
    {
      "req_id": "REQ-PWR-001",
      "title": "Remaining flight time estimate",
      "text": "The ground station shall estimate remaining flight time from battery state of charge and current load, updating the estimate at least once per second.",
      "subsystem": "Power Management",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-PWR-002",
      "title": "Low battery warnings",
      "text": "The ground station shall warn the operator when battery charge falls below 30 percent and again below 20 percent.",
      "subsystem": "Power Management",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-PWR-003",
      "title": "Arming voltage interlock",
      "text": "The ground station shall prevent arming when battery voltage is below the configured safe threshold.",
      "subsystem": "Power Management",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-PWR-004",
      "title": "Battery telemetry logging",
      "text": "The ground station shall log battery voltage, current, and temperature at a minimum rate of 1 Hz.",
      "subsystem": "Power Management",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-PWR-005",
      "title": "Hot-swap battery detection",
      "text": "The ground station shall detect a battery hot-swap event and re-initialise power telemetry within 3 seconds.",
      "subsystem": "Power Management",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-PWR-006",
      "title": "Load shedding on critical battery",
      "text": "On reaching the critical battery threshold, the ground station shall command shutdown of non-essential payload loads.",
      "subsystem": "Power Management",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-001",
      "title": "Map state update latency",
      "text": "The operator map shall reflect received aircraft state within 500 ms of message receipt.",
      "subsystem": "Operator Interface",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-002",
      "title": "Flight termination confirmation",
      "text": "The operator interface shall require an explicit two-step confirmation before a flight termination command can be sent.",
      "subsystem": "Operator Interface",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-003",
      "title": "Audible alerts for critical events",
      "text": "The operator interface shall produce an audible alert for every event classified as Critical.",
      "subsystem": "Operator Interface",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-004",
      "title": "Pre-flight checklist tracking",
      "text": "The operator interface shall present a pre-flight checklist and record completion state for each item.",
      "subsystem": "Operator Interface",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-005",
      "title": "Offline map operation",
      "text": "The operator interface shall support full map operation, including route editing, without network connectivity using cached map tiles.",
      "subsystem": "Operator Interface",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-006",
      "title": "Operator action audit log",
      "text": "The operator interface shall record every operator command in a tamper-evident audit log.",
      "subsystem": "Operator Interface",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-UI-007",
      "title": "Night operations display mode",
      "text": "The operator interface shall provide a reduced-brightness night mode suitable for dark environments.",
      "subsystem": "Operator Interface",
      "priority": "Low",
      "verification_method": "Demonstration"
    },
    {
      "req_id": "REQ-SAF-001",
      "title": "Lost-link failsafe",
      "text": "After a configurable lost-link timeout, the system shall execute the configured failsafe behaviour without operator input.",
      "subsystem": "Safety & Failsafe",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-002",
      "title": "Pre-arm safety check interlock",
      "text": "The system shall prevent takeoff when any pre-arm safety check has failed.",
      "subsystem": "Safety & Failsafe",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-003",
      "title": "Altitude ceiling enforcement",
      "text": "The system shall prevent the aircraft from exceeding the operator-configured altitude ceiling.",
      "subsystem": "Safety & Failsafe",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-004",
      "title": "Motor fault response",
      "text": "On detection of a motor fault, the system shall initiate a controlled descent at the current position.",
      "subsystem": "Safety & Failsafe",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-005",
      "title": "Geofence override confirmation",
      "text": "Overriding a geofence boundary shall require a two-step operator confirmation and shall be recorded in the audit log.",
      "subsystem": "Safety & Failsafe",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-006",
      "title": "Flight controller heartbeat monitoring",
      "text": "The ground station shall monitor the flight controller heartbeat at 10 Hz and declare a fault after three missed cycles.",
      "subsystem": "Safety & Failsafe",
      "priority": "Critical",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-SAF-007",
      "title": "Failsafe annunciation latency",
      "text": "The operator interface shall annunciate failsafe activation within 1 second of the triggering event.",
      "subsystem": "Safety & Failsafe",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-DAT-001",
      "title": "Telemetry recording to local storage",
      "text": "The ground station shall record all received telemetry to local storage in an open, documented file format.",
      "subsystem": "Mission Data & Logging",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-DAT-002",
      "title": "Log synchronisation on reconnection",
      "text": "When network connectivity is restored, the ground station shall synchronise stored mission logs to the configured server.",
      "subsystem": "Mission Data & Logging",
      "priority": "Medium",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-DAT-003",
      "title": "Log integrity checksums",
      "text": "Each stored mission log shall carry a checksum that allows later detection of modification or corruption.",
      "subsystem": "Mission Data & Logging",
      "priority": "High",
      "verification_method": "Test"
    },
    {
      "req_id": "REQ-DAT-004",
      "title": "Mission data export",
      "text": "The ground station shall export mission data in at least one open format suitable for third-party analysis tools.",
      "subsystem": "Mission Data & Logging",
      "priority": "Low",
      "verification_method": "Demonstration"
    },
    {
      "req_id": "REQ-DAT-005",
      "title": "Log retention period",
      "text": "The ground station shall retain mission logs for at least 90 days before any automatic deletion.",
      "subsystem": "Mission Data & Logging",
      "priority": "Low",
      "verification_method": "Inspection"
    },
    {
      "req_id": "REQ-DAT-006",
      "title": "GPS time synchronisation of records",
      "text": "All recorded data shall be timestamped against GPS time with a maximum error of 100 ms.",
      "subsystem": "Mission Data & Logging",
      "priority": "High",
      "verification_method": "Test"
    }
  ],
